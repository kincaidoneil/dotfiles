{
  "env": {
    "AGENT_GITHUB_APP_ID": "5911907",
    "AGENT_GITHUB_APP_KEY": "keychain:agent-github-app-key"
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "enabledPlugins": {
    "mattpocock-skills@mattpocock": true
  },
  "extraKnownMarketplaces": {
    "mattpocock": {
      "source": {
        "source": "github",
        "repo": "mattpocock/skills"
      },
      "autoUpdate": true
    }
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "autoCompactWindow": 400000
    }
  },
  "theme": "light",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "autoMode": {
    "allow": [
      "$defaults",
      "Bash(process-compose:*) in ~/sideby — routine local dev service orchestration (67 uses this project, defined in package.json dev/dev:up/dev:down scripts)"
    ]
  },
  "preferredNotifChannel": "terminal_bell"
}
